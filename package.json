{
  "name": "@nukeviet/ckeditor5-nviframe",
  "version": "49.1.0",
  "description": "Iframe management for CKEditor 5 integrated with NukeViet.",
  "keywords": [
    "nukeviet",
    "nukeviet 4",
    "nukeviet 4.5",
    "nukeviet 4.6",
    "nukeviet 5",
    "nukeviet ckeditor",
    "nukeviet ckeditor5"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "peerDependencies": {
    "@ckeditor/ckeditor5-core": "49.1.0",
    "ckeditor5": "49.1.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*",
    "./browser/*": null,
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ckeditor5-metadata.json"
  ],
  "engines": {
    "node": ">=26.10.0"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-core": "latest",
    "@ckeditor/ckeditor5-dev-build-tools": "63.1.3",
    "@ckeditor/ckeditor5-dev-translations": "63.1.3",
    "@ckeditor/ckeditor5-inspector": "^5.0.4",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/browser-webdriverio": "^4.1.7",
    "@vitest/coverage-istanbul": "^4.1.7",
    "ckeditor5": "latest",
    "eslint": "^10.0.0",
    "eslint-config-ckeditor5": "^23.0.0",
    "eslint-plugin-ckeditor5-rules": "^23.0.0",
    "globals": "^16.1.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.2.6",
    "typescript": "5.8.3",
    "vite": "^8.1.2",
    "vite-plugin-svgo": "^2.0.0",
    "vitest": "^4.1.7",
    "webdriverio": "^9.19.2"
  },
  "overrides": {
    "sugarss": "^5.0.1"
  },
  "author": "VINADES.,JSC (https://vinades.vn/)",
  "license": "GPL-2.0-or-later",
  "homepage": "https://nukeviet.vn/",
  "bugs": "https://github.com/nukeviet/nukeviet/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/nukeviet/ckeditor5-nviframe.git"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run build:types && npm run build:npm && npm run build:browser",
    "build:npm": "vite build --mode npm",
    "build:browser": "vite build --mode browser",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --browser.headless=false",
    "lint": "eslint",
    "translations:synchronize": "node ./scripts/synchronize-translations.js",
    "translations:validate": "node ./scripts/synchronize-translations.js --validate-only",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "**/*": [
      "eslint"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
